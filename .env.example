# ============================================================================
# XLOOP PANEL — Environment Variables
#
# Cara pakai:
#   1. Copy file ini menjadi `.env.local` untuk development lokal.
#   2. Untuk production, isi variable yang sama di
#      Vercel → Project → Settings → Environment Variables.
#
# Catatan:
#   - Kalau ketiga variable Supabase di bawah KOSONG, panel otomatis jalan
#     dalam mode SQLite lokal (file `data/xloop.sqlite`) — cocok untuk demo.
#   - Variable rahasia (service role, private key, CRON_SECRET) TIDAK BOLEH
#     memakai prefix NEXT_PUBLIC_ dan tidak boleh di-commit.
# ============================================================================

# --- Database: Supabase (wajib untuk production) ----------------------------

# Project URL Supabase (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Anon public key — aman di browser karena dibatasi Row Level Security
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role secret key — HANYA dipakai di server (API routes)
SUPABASE_SERVICE_ROLE_KEY=

# --- Signing lisensi: keypair Ed25519 ---------------------------------------
# Generate sekali dengan:  npm run generate-keypair
# (atau `node scripts/generate-keypair.mjs --write` untuk langsung menulis ke sini)

# Private key (PKCS8 PEM → base64 satu baris) — menandatangani response /api/validate
LICENSE_SIGNING_PRIVATE_KEY=

# Public key (SPKI PEM → base64 satu baris) — ditanam di tool/mod client
LICENSE_SIGNING_PUBLIC_KEY=

# Masa berlaku token validasi dalam detik. Default: 900 (15 menit)
LICENSE_TOKEN_TTL_SECONDS=900

# --- Cron (Vercel Cron Jobs) --------------------------------------------------
# /api/cron/cleanup dan /api/cron/digest menolak request tanpa header
#   Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# --- Mode database (opsional) --------------------------------------------------
# Paksa mode: `supabase` atau `sqlite`. Kosong = deteksi otomatis
XLOOP_DB=

# Lokasi file SQLite. Default: data/xloop.sqlite
XLOOP_SQLITE_PATH=

# 1 = paksa mode SQLite (flag lama, tetap didukung). JANGAN dipakai di production
NEXT_PUBLIC_MOCK_MODE=

# --- Notifikasi (opsional) ------------------------------------------------------
# URL webhook HTTP milikmu untuk meneruskan notifikasi panel
# (auto-ban, brute-force, saldo tipis, ringkasan harian).
# Kegagalan pengiriman tidak pernah menggagalkan aksi utama.
XLOOP_NOTIFY_WEBHOOK_URL=
